# OpenAI
OPENAI_API_KEY=

# Azure OpenAI (set PARKING_LLM_PROVIDER=azure and PARKING_CHAT_MODEL to the deployment name)
# PARKING_LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=2024-10-21

# Administrator agent (Telegram): create a bot with @BotFather, put the token here only in .env
PARKING_TELEGRAM_BOT_TOKEN=
# Chat id of the administrator; run `parking-assistant admin` with only the token set, message the bot, and it prints the id
PARKING_TELEGRAM_ADMIN_CHAT_ID=0

# MCP server that stores confirmed reservations. Use a long random secret (at least 24 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PARKING_MCP_TOKEN=
# PARKING_MCP_HOST=127.0.0.1
# PARKING_MCP_PORT=8765
# PARKING_RESERVATIONS_FILE=var/confirmed_reservations.txt
# Clients can use another URL than host:port (docker compose sets it to http://mcp:8765/mcp)
# PARKING_MCP_SERVER_URL=
# Extra Host names the MCP server accepts when it is reached through a name other than localhost
# PARKING_MCP_ALLOWED_HOSTS=
# Workflow checkpoints (shared by chat and administrator processes)
# PARKING_WORKFLOW_DB=var/workflow.sqlite
